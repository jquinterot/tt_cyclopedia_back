# ==========================================
# Database Configuration
# ==========================================

# Primary SQL Database (PostgreSQL)
SQL_DB=postgresql://postgres:postgres@localhost:5432/tt_cyclopedia

# SQLite fallback for tests
SQL_LITE_DB=sqlite:///./test.db

# Dedicated test database URL (used by Docker tests)
TEST_SQL_DB=sqlite:///:memory:

# ==========================================
# MongoDB Configuration
# ==========================================

# Local MongoDB
MONGO_DB=mongodb://localhost:27017
MONGO_DB_NAME=tt_cyclopedia

# MongoDB Atlas (production)
# MONGO_DB=mongodb+srv://username:password@cluster.mongodb.net/
# MONGO_DB_NAME=tt_cyclopedia

# ==========================================
# Cloudinary Configuration (image storage)
# ==========================================

# Option 1: Individual credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Option 2: Single URL (alternative format)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Default image URL for missing images
DEFAULT_IMAGE_URL=/static/default/default.jpeg

# ==========================================
# Authentication & Security
# ==========================================

# JWT secret key (generate a strong random string for production)
JWT_SECRET_KEY=your_super_secret_jwt_key_change_in_production

# Account lockout settings
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ==========================================
# Application Environment
# ==========================================

# Environment: development | testing | production
ENVIRONMENT=development

# Set to "true" when running inside Docker
DOCKER_ENV=false

# Set to "true" during pytest runs
TESTING=false

# ==========================================
# CORS & Networking
# ==========================================

# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ==========================================
# Logging
# ==========================================

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ==========================================
# SSL / Database Encryption (Production)
# ==========================================

# Enable SSL for PostgreSQL connections
DATABASE_SSL=false

# SSL certificate paths (required if DATABASE_SSL=true)
SSL_ROOT_CERT=
SSL_CLIENT_CERT=
SSL_CLIENT_KEY=

# ==========================================
# HTTPS & Proxy Headers (Production)
# ==========================================

# Enable HTTPS redirect middleware
ENABLE_HTTPS_REDIRECT=false

# Enable proxy headers (when behind a reverse proxy)
ENABLE_PROXY_HEADERS=false

# Comma-separated trusted proxies
TRUSTED_PROXIES=127.0.0.1,localhost

# Number of trusted proxy hops
TRUSTED_PROXY_DEPTH=1

# ==========================================
# Security Headers (Production)
# ==========================================

# Enable Strict-Transport-Security header
ENABLE_HSTS=false

# Enable Content-Security-Policy header
ENABLE_CSP=false
ENABLE_CONTENT_SECURITY_POLICY=true

# Enable XSS protection header
ENABLE_XSS_PROTECTION=true

# Legacy production flag used by some middleware
PRODUCTION=false
